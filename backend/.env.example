# ── Database ──────────────────────────────────────────────
# Local:
# DATABASE_URL=postgresql+asyncpg://kimtvh@localhost:5433/shopho_db
# Railway:
DATABASE_URL=postgresql+asyncpg://postgres:YOUR_PASSWORD@ballast.proxy.rlwy.net:56769/shopho_db
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# ── Redis ─────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Security ──────────────────────────────────────────────
SECRET_KEY=CHANGE_ME_USE_openssl_rand_hex_32
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# ── File Storage (MinIO – local S3-compatible) ────────────
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=shopho-images
MINIO_USE_SSL=false

# ── App ───────────────────────────────────────────────────
APP_ENV=development
CORS_ORIGINS=["http://localhost:3000"]

# ── Contact ───────────────────────────────────────────────
ZALO_CONTACT=0900000000

# ── Version gate ──────────────────────────────────────────
APP_MIN_VERSION=1.0.0
APP_LATEST_VERSION=1.0.0
ANDROID_STORE_URL=https://play.google.com/store/apps/details?id=com.yourcompany.shopho
IOS_STORE_URL=https://apps.apple.com/app/shopho/id0000000000
